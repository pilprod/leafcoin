    {
      "@type": "CreativeWork",
      "@id": "https://leafcoin.org/#architecture",
      "url": "https://leafcoin.org/#architecture",
      "name": "A data layer before a token layer.",
      "description": "The proposed architecture separates data collection, off-chain storage and ledger-based integrity checks. Raw telemetry would remain off-chain, while the ledger would hold report hashes.",
      "creativeWorkStatus": "Proposed concept component",
      "inLanguage": "en",
      "isPartOf": {
        "@id": "https://leafcoin.org/#concept"
      }
    },
    {
      "@type": "CreativeWork",
      "@id": "https://leafcoin.org/#calibration",
      "url": "https://leafcoin.org/#calibration",
      "name": "Learn from each growing cycle.",
      "description": "A proposed research loop would use repeated cultivation iterations to evaluate irrigation schedules and nutrient-solution composition against observed plant responses. This is a proposed research direction. Repeated measurements and experiments would be needed to establish model quality and useful operating limits. Sensor calibration would remain a separate requirement.",
      "creativeWorkStatus": "Proposed concept component",
      "inLanguage": "en",
      "isPartOf": {
        "@id": "https://leafcoin.org/#concept"
      }
    },
