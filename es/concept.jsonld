    {
      "@type": "Article",
      "@id": "https://leafcoin.org/es/articles/what-is-aeroponics.html#article",
      "url": "https://leafcoin.org/es/articles/what-is-aeroponics.html",
      "headline": "¿Qué es la aeroponía? Cómo crecen las raíces sin suelo",
      "description": "Descubre cómo la aeroponía alimenta raíces suspendidas con una neblina nutritiva, qué contiene un sistema y en qué se diferencia de la hidroponía y la agricultura vertical.",
      "inLanguage": "es",
      "author": {
        "@id": "https://papou.work/#person"
      },
      "datePublished": "2026-10-13",
      "dateModified": "2026-10-13",
      "isPartOf": {
        "@id": "https://leafcoin.org/es/articles/#library"
      }
    },
    {
      "@type": "Article",
      "@id": "https://leafcoin.org/es/articles/aeroponics-vs-hydroponics.html#article",
      "url": "https://leafcoin.org/es/articles/aeroponics-vs-hydroponics.html",
