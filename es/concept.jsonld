    {
      "@type": "CreativeWork",
      "@id": "https://leafcoin.org/es/#architecture",
      "url": "https://leafcoin.org/es/#architecture",
      "name": "Primero los datos. Después los tokens.",
      "description": "La arquitectura propuesta separa la recopilación de datos, el almacenamiento fuera de la cadena y la comprobación de integridad mediante un libro mayor. La telemetría sin procesar permanecería fuera de la cadena, mientras que el libro mayor almacenaría hashes de los informes.",
      "creativeWorkStatus": "Proposed concept component",
      "inLanguage": "es",
      "isPartOf": {
        "@id": "https://leafcoin.org/es/#concept"
      }
    },
    {
      "@type": "CreativeWork",
      "@id": "https://leafcoin.org/es/#calibration",
      "url": "https://leafcoin.org/es/#calibration",
      "name": "Aprender de cada ciclo de cultivo.",
      "description": "Un ciclo de investigación propuesto utilizaría iteraciones de cultivo repetidas para evaluar los programas de riego y la composición de la solución nutritiva según las respuestas observadas en las plantas. Esta es una línea de investigación propuesta. Se necesitarían mediciones y experimentos repetidos para establecer la calidad de los modelos y unos límites de operación útiles. La calibración de los sensores seguiría siendo un requisito independiente.",
      "creativeWorkStatus": "Proposed concept component",
      "inLanguage": "es",
      "isPartOf": {
        "@id": "https://leafcoin.org/es/#concept"
      }
    },
    {
      "@type": "CreativeWork",
